---
title: 09. 기업 모집공고 및 참여 신청 (com.expo.recruitment, com.expo.participation)
---
erDiagram

RECRUITMENT_NOTICE_REQUESTS {
    bigint id PK
    bigint host_client_id FK
    varchar title
    text description
    timestamptz application_start_at
    timestamptz application_end_at
    timestamptz event_start_at
    timestamptz event_end_at
    bigint virtual_venue_id FK
    bigint venue_hall_id FK "NULL 허용"
    int target_company_count
    jsonb requested_booth_config
    varchar status "DRAFT/SUBMITTED/UNDER_REVIEW/APPROVED/REJECTED/CANCELED"
    varchar venue_conflict_status "CLEAR/CONFLICT_PENDING/RESOLVED"
    varchar venue_decision "PENDING/ALLOWED/CANCELED"
    varchar conflict_group_key
    timestamptz submitted_at
    bigint decided_by_admin_id FK
    timestamptz decided_at
    text decision_reason
    bigint expo_id FK "NULL 허용, V202608251100 추가"
    timestamptz created_at
    timestamptz updated_at
}

RECRUITMENT_NOTICE_REQUEST_ZONES {
    bigint request_id "PK,FK"
    bigint venue_hall_id FK
    bigint venue_zone_id "PK,FK"
    timestamptz created_at
}

RECRUITMENT_NOTICE_REQUEST_HISTORIES {
    bigint id PK
    bigint request_id FK
    varchar action_type "SUBMIT/REVIEW_START/VENUE_ALLOW/VENUE_CANCEL/APPROVE/REJECT/NOTICE_CREATED"
    varchar from_status
    varchar to_status
    text reason
    bigint processed_by_admin_id FK
    timestamptz created_at
}

RECRUITMENT_NOTICES {
    bigint id PK
    bigint request_id "FK,UK"
    bigint host_client_id FK
    varchar title
    text content
    text eligibility
    jsonb submission_requirements
    timestamptz application_start_at
    timestamptz application_end_at
    varchar status "DRAFT/SCHEDULED/OPEN/CLOSED/CANCELED/ARCHIVED"
    timestamptz published_at
    timestamptz closed_at
    bigint created_by_admin_id FK
    bigint expo_id FK "NULL 허용, V202608251100 추가"
    timestamptz created_at
    timestamptz updated_at
}

RECRUITMENT_NOTICE_HISTORIES {
    bigint id PK
    bigint recruitment_notice_id FK
    varchar action_type "CREATE/PUBLISH/ACTIVATE/UPDATE/CLOSE/CANCEL/ARCHIVE"
    jsonb before_data
    jsonb after_data
    text reason
    bigint processed_by_admin_id FK
    timestamptz created_at
}

RECRUITMENT_RESULTS {
    bigint id PK
    bigint recruitment_notice_id "FK,UK"
    bigint host_client_id FK
    int confirmed_company_count
    int confirmed_booth_count
    numeric total_booth_sales_amount
    varchar status "GENERATED/DELIVERED/CONFIRMED/USED_FOR_EXPO/CANCELED"
    timestamptz generated_at
    timestamptz delivered_at
    timestamptz confirmed_by_host_at
    timestamptz created_at
}

RECRUITMENT_RESULT_ITEMS {
    bigint id PK
    bigint recruitment_result_id FK
    bigint application_id "FK,UK"
    bigint client_user_id FK
    bigint booth_allocation_id "FK,UK"
    numeric booth_amount
    timestamptz created_at
}

PARTICIPATION_APPLICATIONS {
    bigint id PK
    bigint recruitment_notice_id FK
    bigint client_user_id FK
    varchar company_name_snapshot
    text participation_purpose
    text exhibit_description
    bigint selected_booth_product_id FK "NULL 허용"
    bigint booth_order_id FK,UK "NULL 허용"
    varchar status "DRAFT/PAYMENT_PENDING/SUBMITTED/PAYMENT_FAILED/CANCELED"
    timestamptz submitted_at
    timestamptz admin_checked_at
    bigint admin_checked_by FK
    text admin_memo
    timestamptz created_at
    timestamptz updated_at
}

APPLICATION_OPERATION_HISTORIES {
    bigint id PK
    bigint application_id FK
    varchar action_type "CHECKED/CORRECTION_REQUESTED/CORRECTION_COMPLETED/MEMO_UPDATED"
    text message
    bigint processed_by_admin_id FK
    timestamptz created_at
}

