# ==============================================================================
# expo backend 환경변수 샘플
#
# 사용법:  cp env.sample .env   후 값을 채운다.
# .env 는 .gitignore 에 등록되어 있다. 절대 커밋하지 않는다.
#
# 이 파일은 me.paulschwarz:springboot4-dotenv 가 읽는다.
# 읽는 위치는 "애플리케이션 실행 디렉터리" 기준이므로 .env 는 backend/ 바로 아래에 둔다.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database (local 프로필 / PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=expo
POSTGRES_USER=expo
POSTGRES_PASSWORD=

# ------------------------------------------------------------------------------
# JWT
#
# JWT_SECRET 은 HS256 기준 최소 32바이트여야 한다. 아래 명령으로 생성한다.
#   openssl rand -base64 48
# 팀원마다 다른 값을 써도 되지만, 값을 바꾸면 기존에 발급된 토큰은 모두 무효가 된다.
# ------------------------------------------------------------------------------
JWT_SECRET=
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=14

# ------------------------------------------------------------------------------
# OAuth2 소셜 로그인 (Google / Kakao)  -- 2026-08 현재 키 미발급
#
# 중요: 이 값들은 application-oauth2.yml 이 읽으며, 그 파일은 'oauth2' 프로필이
#       켜졌을 때만 로드된다.
#
#   키 발급 전:  SPRING_PROFILES_ACTIVE=local          (아래 값 비워둬도 정상 기동)
#   키 발급 후:  SPRING_PROFILES_ACTIVE=local,oauth2   (아래 값을 채운 뒤)
#
# client-id 만 채우고 client-secret 을 비우면 기동이 실패한다. 항상 쌍으로 관리한다.
#
# 발급처
#   Google : https://console.cloud.google.com/apis/credentials
#            승인된 리디렉션 URI -> http://localhost:8080/login/oauth2/code/google
#   Kakao  : https://developers.kakao.com/console/app
#            Redirect URI       -> http://localhost:8080/login/oauth2/code/kakao
#            client-secret 은 [보안] 탭에서 별도로 활성화해야 발급된다.
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# Toss Payments  -- 키 발급 없이 개발 가능
#
# 토스페이먼츠는 개발자센터 문서에 공개 테스트 키를 제공한다.
# 가입이나 사업자번호 없이 결제 연동을 테스트할 수 있다 (결제 내역 조회는 불가).
# 아래 두 값은 공식 문서에서 복사해 채운다.
#   https://docs.tosspayments.com/reference/using-api/api-keys
#   https://docs.tosspayments.com/blog/how-to-test-toss-payments
#
# TOSS_CLIENT_KEY : test_ck_ 로 시작. 프론트에도 같은 값이 필요하다(front/.env).
# TOSS_SECRET_KEY : test_sk_ 로 시작. 서버 전용. 절대 프론트로 내려보내지 않는다.
# ------------------------------------------------------------------------------
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ------------------------------------------------------------------------------
# Object Storage (S3)
#
# 로컬은 Adobe S3Mock 을 쓴다 (docker compose 로 함께 뜬다, 포트 9090).
# S3Mock 은 자격증명을 검증하지 않으므로 아무 값이나 되며 관례적으로 test/test 를 쓴다.
# 버킷은 컨테이너가 기동할 때 자동으로 만들어진다.
#
# 운영(OCI)에서는 AWS_S3_ENDPOINT 를 실제 S3 호환 엔드포인트로 바꾸고
# (진짜 AWS S3 라면 아예 비우면 된다) 키도 실제 값으로 교체한다.
# ------------------------------------------------------------------------------
AWS_REGION=ap-northeast-2
AWS_S3_ENDPOINT=http://localhost:9090
AWS_S3_BUCKET=expo-local
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ------------------------------------------------------------------------------
# Frontend 연동
#
# OAuth2 로그인 성공 후 프론트로 리다이렉트할 주소. CORS 허용 오리진으로도 쓴다.
# Next.js dev 서버 기본 포트는 3000 이다.
# ------------------------------------------------------------------------------
FRONT_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 휴대폰 본인인증 (PostgreSQL + JPA, MVP 테스트 코드 123456)
# ------------------------------------------------------------------------------
PHONE_VERIFICATION_CODE_EXPIRE_MINUTES=3
PHONE_VERIFICATION_TEST_CODE=123456

# ------------------------------------------------------------------------------
# 이메일 본인인증 (회원가입) — 실제 발송은 위 MAIL_* 설정을 그대로 쓴다.
# MAIL_PROVIDER=logging 이면 인증코드가 메일로 안 가고 서버 로그에만 남는다.
# ------------------------------------------------------------------------------
EMAIL_VERIFICATION_CODE_EXPIRE_MINUTES=5

# ------------------------------------------------------------------------------
# 발권 티켓 QR 서명 키
#
# 티켓 QR 원문을 HMAC-SHA256 으로 서명할 때 쓴다. 아래 명령으로 생성한다.
#   openssl rand -base64 48
#
# JWT_SECRET 과 반드시 다른 값을 쓴다. 하나가 유출됐을 때 로그인 토큰과 입장권이 함께
# 무너지면 안 된다.
#
# 이 값을 바꾸면 이미 발권된 티켓의 QR 이 전부 달라져 현장 체크인이 실패한다.
# 값이 비어 있으면 앱이 기동하지 않는다 (JWT_SECRET 과 동일).
# ------------------------------------------------------------------------------
QR_TOKEN_SECRET=

# ------------------------------------------------------------------------------
# SMS 발송 (Solapi)
#
# SMS_PROVIDER
#   logging (기본) : 실제로 보내지 않고 로그에만 남긴다. 아래 키가 없어도 앱이 뜬다.
#   solapi         : 실제 발송. 아래 세 값이 전부 있어야 하고, 하나라도 비면 기동에 실패한다.
#
# 발신번호는 Solapi 콘솔에서 사전 등록·인증을 마친 번호만 쓸 수 있다.
# 등록되지 않은 번호로는 발송이 거부된다.
#
# 발급처: https://console.solapi.com  →  개발/연동 > API Key 관리
# ------------------------------------------------------------------------------
SMS_PROVIDER=logging
SOLAPI_SMS_API_PUBLIC_KEY=
SOLAPI_SMS_API_SECRET_KEY=
SOLAPI_SENDER_NUMBER=

# ------------------------------------------------------------------------------
# 체크인 · 발권 행 잠금 대기 상한 (ms, 이슈 #74)
#
# PostgreSQL 기본값은 0(무제한)이라, 앞선 트랜잭션이 멈추면 뒤따르는 체크인이 영영 기다리고
# HTTP·DB 커넥션이 함께 묶인다. 넘기면 409 로 "잠시 후 다시 시도해 주세요" 를 돌려준다.
# 로컬 측정 기준 체크인 처리는 중앙값 23ms · 최대 135ms 였다.
# ------------------------------------------------------------------------------
CHECK_IN_LOCK_TIMEOUT_MILLIS=3000
