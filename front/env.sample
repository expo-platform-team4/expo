# ==============================================================================
# expo frontend 환경변수 샘플
#
# 사용법:  cp env.sample .env.local   후 값을 채운다.
# .env* 는 .gitignore 에 등록되어 있다. 절대 커밋하지 않는다.
#
# Next.js 가 .env / .env.local 을 기본으로 읽는다. 별도 라이브러리를 설치하지 않는다.
#
# 경고: NEXT_PUBLIC_ 이 붙은 값은 빌드 산출물에 그대로 박혀 브라우저에서 전부 보인다.
#       시크릿 키(test_sk_ / live_sk_)를 여기에 넣으면 안 된다. 백엔드 .env 전용이다.
# ==============================================================================

# ------------------------------------------------------------------------------
# 백엔드 연동
#
# 두 개로 나뉘어 있는 이유:
#   서버 컴포넌트는 '/api/...' 같은 상대 경로로 fetch 할 수 없다.
#   브라우저처럼 "현재 오리진" 개념이 없어서 절대 URL 이 필요하다.
#   그래서 브라우저용과 서버용을 따로 둔다.
#
# NEXT_PUBLIC_API_BASE_URL : 브라우저(클라이언트 컴포넌트)용.
#                            next.config.ts 의 rewrites 가 /api 를 Spring 으로 넘긴다.
#                            브라우저 기준 same-origin 이라 CORS 설정이 필요 없다.
#
# BACKEND_ORIGIN           : 서버 전용. 서버 컴포넌트 fetch 와 rewrites 대상.
#                            NEXT_PUBLIC_ 이 없으므로 브라우저에 노출되지 않는다.
#                            Docker 에서는 localhost 가 Next 컨테이너 자신이므로
#                            반드시 서비스 이름으로 바꾼다 (예: http://backend:8080).
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=/api
BACKEND_ORIGIN=http://localhost:8080

# ------------------------------------------------------------------------------
# Toss Payments 클라이언트 키 (test_ck_ 로 시작)
#
# 결제창을 띄우는 용도라 공개되어도 되는 값이다.
# 시크릿 키(test_sk_)는 백엔드 .env 에만 둔다.
#   https://docs.tosspayments.com/reference/using-api/api-keys
# ------------------------------------------------------------------------------
NEXT_PUBLIC_TOSS_CLIENT_KEY=
